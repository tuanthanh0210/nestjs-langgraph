{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "file", "title", "explanation", "what_to_check"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "category": {
            "type": "string",
            "enum": [
              "secret-exfiltration",
              "command-execution",
              "ci-backdoor",
              "supply-chain",
              "obfuscation",
              "injection",
              "auth-bypass",
              "data-exposure",
              "prompt-injection-attempt",
              "other"
            ]
          },
          "file": { "type": "string" },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "what_to_check": { "type": "string" }
        }
      }
    }
  }
}
