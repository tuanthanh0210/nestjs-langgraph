# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins, or "*" for any origin.
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────
# LLM
#   LLM_PROVIDER=mock    → deterministic, offline model (no API key)
#   LLM_PROVIDER=openai  → any OpenAI-compatible API
# When LLM_PROVIDER is omitted it defaults to "openai" if an API key
# exists, otherwise "mock" so the app can always boot.
# ─────────────────────────────────────────────────────────────
# Đổi "mock" → "openai" để dùng LLM thật, rồi mở các dòng bên dưới.
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-your-key-here

# DeepSeek / OpenRouter / Ollama / vLLM / LiteLLM all work:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ─────────────────────────────────────────────────────────────
# Agent
# ─────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=8
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# AGENT_SYSTEM_PROMPT=You are a helpful assistant.

# ─────────────────────────────────────────────────────────────
# Store & catalog
# Replace data/products.csv and data/store-info.md with your real data.
# ─────────────────────────────────────────────────────────────
STORE_NAME=NestShop
STORE_HOTLINE=0900 000 000
STORE_EMAIL=hello@nestshop.vn
STORE_ADDRESS=123 Nguyễn Trãi, Quận 1, TP.HCM
PRODUCTS_FILE=./data/products.csv
STORE_INFO_FILE=./data/store-info.md

# ─────────────────────────────────────────────────────────────
# Orders
# Orders are appended to a JSONL file (contains customer PII).
# For production, replace OrderService with a database/payment integration.
# ─────────────────────────────────────────────────────────────
ORDERS_FILE=./data/orders/orders.jsonl
ORDER_PREFIX=ORD
MAX_ORDER_ITEMS=20
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000

# ─────────────────────────────────────────────────────────────
# Persistence
# Empty → in-memory checkpointer (history lost on restart).
# Set → Postgres checkpointer, history survives restarts/deploys.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
DB_POOL_MAX=10

# ─────────────────────────────────────────────────────────────
# API docs
# ─────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────────────────────
# LangSmith tracing (optional)
# ─────────────────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=nestjs-langgraph-agent
